set.seed(42)
run_imputation_pipeline <- function(yearly_prefixes, aggregate_6yr_name, outcome_label) {
cat(paste0("\n>>> STARTING PIPELINE FOR OUTCOME: ", outcome_label, " <<<\n"))
cat("--- STAGE 1: Data Cleaning and Longitudinal Panel Binding ---\n")
years_vector <- 2014:2019
list_of_dfs  <- list()
for (i in seq_along(yearly_prefixes)) {
df_name <- yearly_prefixes[i]
file_path <- file.path(INPUT_DIR, paste0(df_name, ".csv"))
# STREAMING_CHUNK: Safe file-loading sequence with directory fallback...
# Try loading directly from the CSV folder first, fallback to Global Env if not found
if (file.exists(file_path)) {
cat("Loading", df_name, "from file...\n")
current_df <- read.csv(file_path, stringsAsFactors = FALSE, check.names = FALSE)
} else if (exists(df_name, envir = .GlobalEnv)) {
cat("Using existing environment object for", df_name, "...\n")
current_df <- get(df_name, envir = .GlobalEnv)
} else {
stop(paste("Error: Could not find CSV file at:", file_path, "nor as an object in your R environment!"))
}
# Convert all columns to numeric (strings like "Suppressed" automatically become NA)
current_df[] <- lapply(current_df, function(x) as.numeric(as.character(x)))
# Drop rows without a valid County Code
current_df <- current_df[!is.na(current_df$`County Code`), ]
# Assign the correct year
current_df$Year <- years_vector[i]
list_of_dfs[[i]] <- current_df
}
yearly_data_long <- bind_rows(list_of_dfs) %>%
arrange(County Code, Year)

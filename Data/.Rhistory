setwd("C:/Users/Martin/Desktop/MartinDo_Project_folder/Data")
import pandas as pd
# ============================================
# Load packages
# ============================================
library(gsynth)
# ============================================
# Step 1: Load data
# ============================================
setwd("C:/Users/Martin/Desktop/MartinDo_HowDoMigrationProspectaffectHumancapitalformation/a_microdata")
data <- read.csv("student_data_2000_3_6_9.csv")
library(gsynth)
data <- read.csv("student_data_2000_3_6_9.csv")
# ============================================
# Step 2: Remove variables with only missing values
# ============================================
data_clean <- data[, !names(data) %in% c(
"mother_educ",
"father_educ",
"computer"
)]
# ============================================
# Step 3: Clean country and year variables
# ============================================
data_clean$country <- trimws(data_clean$country)
data_clean$year <- trimws(data_clean$year)
# ============================================
# Step 4: Keep only treatment and control countries
# ============================================
treatment_countries <- c(
"POL",
"CZE",
"HUN",
"LVA"
)
control_countries <- c(
"BEL",
"FRA",
"GRC",
"IRL",
"ISL",
"ITA",
"LUX",
"NLD",
"NOR",
"PRT",
"CHE",
"ESP",
"DNK",
"DEU",
"FIN",
"RUS",
"AUT",
"SWE"
)
data_clean <- data_clean[
data_clean$country %in% c(
treatment_countries,
control_countries
),
]
# ============================================
# Step 5: Create unique observation identifier
# ============================================
# Every row represents a new student cohort observation
# Therefore we create a unique row identifier
data_clean$unique_id <- seq_len(nrow(data_clean))
# ============================================
# Step 6: Convert numerical categorical variables
# ============================================
data_clean$television <- as.numeric(
gsub("\\+", "", as.character(data_clean$television))
)
data_clean$computer_n <- as.numeric(
gsub("\\+", "", as.character(data_clean$computer_n))
)
data_clean$car <- as.numeric(
gsub("\\+", "", as.character(data_clean$car))
)
# ============================================
# Step 7: Impute numerical missing values
# ============================================
data_clean$math[
is.na(data_clean$math)
] <- mean(data_clean$math, na.rm = TRUE)
data_clean$read[
is.na(data_clean$read)
] <- mean(data_clean$read, na.rm = TRUE)
data_clean$science[
is.na(data_clean$science)
] <- mean(data_clean$science, na.rm = TRUE)
data_clean$wealth[
is.na(data_clean$wealth)
] <- mean(data_clean$wealth, na.rm = TRUE)
data_clean$escs[
is.na(data_clean$escs)
] <- mean(data_clean$escs, na.rm = TRUE)
data_clean$television[
is.na(data_clean$television)
] <- mean(data_clean$television, na.rm = TRUE)
data_clean$computer_n[
is.na(data_clean$computer_n)
] <- mean(data_clean$computer_n, na.rm = TRUE)
data_clean$car[
is.na(data_clean$car)
] <- mean(data_clean$car, na.rm = TRUE)
# ============================================
# Step 8: Mode imputation function
# ============================================
mode_impute <- function(x){
x_no_na <- na.omit(x)
names(sort(table(x_no_na),
decreasing = TRUE))[1]
}
# ============================================
# Step 9: Impute categorical variables
# ============================================
data_clean$gender[
is.na(data_clean$gender)
] <- mode_impute(data_clean$gender)
data_clean$internet[
is.na(data_clean$internet)
] <- mode_impute(data_clean$internet)
data_clean$desk[
is.na(data_clean$desk)
] <- mode_impute(data_clean$desk)
data_clean$room[
is.na(data_clean$room)
] <- mode_impute(data_clean$room)
data_clean$dishwasher[
is.na(data_clean$dishwasher)
] <- mode_impute(data_clean$dishwasher)
data_clean$book[
is.na(data_clean$book)
] <- mode_impute(data_clean$book)
# ============================================
# Step 10: Create treatment variable
# ============================================
# Treatment countries receive treatment status
# in every year.
# gsynth identifies the intervention timing
# through the change from pre to post.
data_clean$treat <- ifelse(
data_clean$country %in% treatment_countries,
1,
0
)
# ============================================
# Step 11: Check treatment structure
# ============================================
table(
data_clean$treat,
data_clean$year
)
table(
data_clean$country,
data_clean$treat
)
# ============================================
# Step 12: Check missing values
# ============================================
sum(is.na(data_clean))
# ============================================
# Step 13: Run gsynth
# ============================================
result_math <- gsynth(
Y = "math",
D = "treat",
data = data_clean,
index = c(
"unique_id",
"year"
),
force = "two-way",
se = TRUE,
CV = TRUE
)
View(data_clean)
